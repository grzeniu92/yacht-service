---
import Logo from './Logo.astro';
import { langs, pagePath, routes, ui, type Lang, type PageKey } from '../i18n';

interface Props {
  lang: Lang;
  /** Path of the current page in every language, for the language switcher. */
  alternates: Record<Lang, string>;
  current?: PageKey | 'product';
}
const { lang, alternates, current } = Astro.props;
const t = ui[lang];

const items: PageKey[] = ['about', 'products', 'partners', 'contact', 'subsidies'];
const nav = items.filter((key) => routes[lang][key]);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={pagePath(lang, 'home')} aria-label="Yacht Service"><Logo /></a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label={t.menu} />
    <label for="nav-toggle" class="burger" aria-hidden="true"><span></span></label>

    <nav class="nav" aria-label="Main">
      <ul>
        {
          nav.map((key) => (
            <li>
              <a
                href={pagePath(lang, key)}
                aria-current={current === key || (key === 'products' && current === 'product') ? 'page' : undefined}
              >
                {t.nav[key as keyof typeof t.nav]}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="langs" aria-label={t.language}>
        {
          langs.map((code) => (
            <li>
              <a href={alternates[code]} hreflang={code} lang={code} aria-current={code === lang ? 'true' : undefined}>
                {code.toUpperCase()}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--gelcoat);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    gap: 1.5rem;
  }
  .brand {
    text-decoration: none;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 2.2rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 1.8rem;
  }
  .nav a {
    font-family: var(--font-ui);
    text-decoration: none;
    color: var(--ink);
    font-weight: 600;
    font-size: 0.95rem;
    padding-block: 0.4rem;
    border-bottom: 2px solid transparent;
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--indigo);
    border-bottom-color: var(--signal);
  }
  .langs {
    gap: 0.9rem;
    padding-left: 1.6rem;
    border-left: 1px solid var(--line);
  }
  .langs a {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .langs a[aria-current='true'] {
    color: var(--indigo);
    font-weight: 800;
    border-bottom-color: var(--signal);
  }
  .nav-toggle,
  .burger {
    display: none;
  }

  @media (max-width: 900px) {
    .burger {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      cursor: pointer;
    }
    .burger span,
    .burger span::before {
      display: block;
      width: 24px;
      height: 2px;
      background: var(--indigo);
    }
    .burger span::before {
      content: '';
      transform: translateY(7px);
    }
    .nav-toggle:focus-visible + .burger {
      outline: 3px solid var(--blue);
    }
    .nav {
      position: absolute;
      inset: var(--header-h) 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--gelcoat);
      border-bottom: 1px solid var(--line);
      padding: 0.5rem 1.25rem 1.25rem;
      display: none;
    }
    .nav-toggle:checked ~ .nav {
      display: flex;
    }
    .nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .nav li a {
      display: block;
      padding: 0.9rem 0;
      border-bottom: 1px solid var(--line);
      font-size: 1.1rem;
    }
    .langs {
      flex-direction: row !important;
      gap: 0.4rem !important;
      padding: 1rem 0 0;
      border-left: 0;
    }
    .langs li a {
      display: inline-block;
      padding: 0.4rem 0.8rem;
      border-bottom: 0;
    }
  }
</style>
