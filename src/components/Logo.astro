---
interface Props {
  /** Hide the wordmark and show only the sail symbol. */
  markOnly?: boolean;
}
const { markOnly = false } = Astro.props;
---

<span class="logo">
  <svg class="logo-mark" viewBox="0 0 1085 1040" aria-hidden="true">
    <path d="M543 392H8v640h665V870" fill="none" stroke="currentColor" stroke-width="16" class="frame" />
    <path d="M0 1008h688v32H0z" class="frame-fill" />
    <path d="M702 0 370 853h332z" class="sail-a" />
    <path d="M740 85v662h345z" class="sail-b" />
  </svg>
  {!markOnly && <span class="logo-word">Yacht<span>Service</span></span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
  }
  .logo-mark {
    height: 2.6rem;
    width: auto;
  }
  .frame {
    color: var(--slate);
  }
  .frame-fill {
    fill: var(--slate);
  }
  .sail-a {
    fill: var(--indigo);
  }
  .sail-b {
    fill: var(--blue);
  }
  .logo-word {
    font-family: var(--font-ui);
    font-weight: 800;
    font-stretch: 125%;
    text-transform: uppercase;
    font-size: 1.35rem;
    letter-spacing: 0.01em;
    line-height: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .logo-word span {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.62rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--slate);
  }
</style>
