---
import Logo from './Logo.astro';
import { company, pagePath, routes, ui, type Lang, type PageKey } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const links = (['about', 'products', 'partners', 'contact', 'subsidies'] as PageKey[]).filter((key) => routes[lang][key]);
---

<footer class="site-footer">
  <div class="wrap top">
    <p class="ask">{t.contactTitle}</p>
    <a class="phone" href={`tel:${company.phoneHref}`}>{company.phone}</a>
    <a class="mail" href={`mailto:${company.email}`}>{company.email}</a>
  </div>
  <div class="wrap grid">
    <a class="brand" href={pagePath(lang, 'home')} aria-label="Yacht Service"><Logo /></a>
    <address>
      {company.name}<br />
      {company.street}, {company.city}<br />
      {t.hours}: {t.hoursValue}
    </address>
    <nav aria-label="Footer">
      <ul>
        {links.map((key) => <li><a href={pagePath(lang, key)}>{t.nav[key as keyof typeof t.nav]}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="wrap legal">© {new Date().getFullYear()} {company.name}</div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: #cfd3ea;
    margin-top: clamp(3rem, 7vw, 6rem);
    padding-top: clamp(3rem, 6vw, 5rem);
    font-size: 1rem;
  }
  .site-footer :global(.logo) {
    color: var(--white);
  }
  .site-footer :global(.sail-a),
  .site-footer :global(.sail-b),
  .site-footer :global(.frame-fill) {
    fill: #b9c3f0;
  }
  .site-footer :global(.frame),
  .site-footer :global(.logo-word span) {
    color: #b9c3f0;
  }
  .top {
    display: grid;
    gap: 0.4rem;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .ask {
    margin: 0;
    font-size: 1.15rem;
  }
  .phone {
    font-family: var(--font-ui);
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(1.9rem, 6vw, 4.2rem);
    line-height: 1.1;
    color: var(--white);
    text-decoration: none;
    width: fit-content;
  }
  .phone:hover {
    color: var(--signal);
  }
  .mail {
    color: #e6e9fb;
    font-size: 1.25rem;
    width: fit-content;
  }
  .mail:hover {
    color: var(--signal);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.2fr 1.4fr 1fr;
    gap: 2.5rem;
    align-items: start;
    padding-block: 2.2rem;
    border-top: 1px solid rgb(255 255 255 / 16%);
  }
  address {
    font-style: normal;
    line-height: 1.7;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }
  nav a {
    color: #e6e9fb;
    text-decoration: none;
    font-family: var(--font-ui);
    font-weight: 600;
  }
  nav a:hover {
    color: var(--signal);
    text-decoration: underline;
  }
  .legal {
    padding-block: 1.4rem;
    font-size: 0.85rem;
    color: #9aa0c8;
    border-top: 1px solid rgb(255 255 255 / 16%);
  }
  @media (max-width: 800px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
