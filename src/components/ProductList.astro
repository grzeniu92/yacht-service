---
import { Image } from 'astro:assets';
import { categories, productPath, productTitle, products, ui, type Lang } from '../i18n';
import { photo } from '../lib/photos';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

{
  categories.map((category) => (
    <section class="category" id={category}>
      <div class="intro">
        <h2>{t.categories[category]}</h2>
        <p>{t.categoryBlurb[category]}</p>
      </div>
      <ul>
        {products
          .filter((p) => p.category === category)
          .map((p) => (
            <li>
              <a href={productPath(lang, p.slug)}>
                <span class="name">{productTitle(p, lang)}</span>
                <Image class="preview" src={photo(p.featured)} alt="" widths={[240, 480]} sizes="320px" />
              </a>
            </li>
          ))}
      </ul>
    </section>
  ))
}

<style>
  .category {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    padding-block: 2.5rem;
    border-top: 1px solid var(--line);
  }
  .intro p {
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.55;
    max-width: 30ch;
  }
  .intro {
    align-self: start;
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li + li {
    border-top: 1px solid var(--line);
  }
  li {
    position: relative;
  }
  a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.9rem;
    text-decoration: none;
  }
  .name {
    font-family: var(--font-ui);
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(1.7rem, 4vw, 3.2rem);
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--indigo);
    overflow-wrap: anywhere;
    transition: color 0.15s;
  }
  a:hover .name,
  a:focus-visible .name {
    color: var(--blue);
  }
  a :global(.preview) {
    flex: none;
    width: 96px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  /* On pointer devices the photo appears beside the name only while it is pointed at. */
  @media (hover: hover) and (min-width: 900px) {
    a :global(.preview) {
      position: absolute;
      right: 0;
      top: 50%;
      width: 320px;
      z-index: 2;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-50%);
      transition: opacity 0.2s;
      box-shadow: 0 18px 40px -16px rgb(35 34 74 / 45%);
    }
    a:hover :global(.preview),
    a:focus-visible :global(.preview) {
      opacity: 1;
    }
  }

  @media (max-width: 800px) {
    .category {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .intro {
      position: static;
    }
  }
</style>
